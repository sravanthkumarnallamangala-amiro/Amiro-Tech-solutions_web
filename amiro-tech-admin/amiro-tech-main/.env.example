# ---- Website text chat AI (local Ollama) ----------------------------------
# Install Ollama, then run: ollama pull qwen2.5:1.5b
# For a deployed site, OLLAMA_URL must point to a server reachable by the app's API.
VITE_CHAT_AI=true
CHAT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Optional hosted alternative: CHAT_PROVIDER=anthropic, with this server-side key.
ANTHROPIC_API_KEY=
CHAT_MODEL=

# ---- Admin area (/admin) -------------------------------------------------
# First administrator. Created automatically on first sign-in; afterwards manage admins inside /admin/admins.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=use-a-long-unique-password
# Random string (16+ chars) used to sign login cookies. Generate with:  openssl rand -base64 32
SESSION_SECRET=

# ---- Database (required when deployed on Vercel) ---------------------------
# Add "Upstash Redis" from the Vercel Marketplace (Storage tab); these are injected automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
